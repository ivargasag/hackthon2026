{
  "name": "hackathon-poc",
  "version": "1.0.0",
  "description": "POC for automated testing with Playwright MCP based on Git changes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "nodemon": "^3.1.0"
  }
}
